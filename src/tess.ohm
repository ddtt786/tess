// ============================================================================
//  Tess -- text-based language compiled to Entry block code
//  Ohm grammar definition (per spec.md)
//
//  Rule naming convention
//    - Capitalized (syntactic rules): auto-skips whitespace/newlines/comments
//    - Lowercase (lexical rules): no auto-skip. Used for keywords, literals, identifiers
//
//  Note: `end` is an Ohm built-in rule (end of input) and cannot be redefined,
//        so the block-closing `end` keyword is defined under the name `end_`.
// ============================================================================
Tess {

  // ==========================================================================
  //  1. Program structure
  // ==========================================================================

  Program = TopLevelItem*

  // `use` inlines the target file's contents in place, so an included
  // fragment file may contain only object/text declarations.
  // Top-level therefore also allows object/text declarations.
  TopLevelItem
    = ProjectDecl
    | SceneDecl
    | ObjectDecl
    | TextDecl
    | FunctionDecl
    | UseObjectDecl
    | UseDecl
    | VarDecl
    | ListDecl

  // --- 3.3 file inclusion -----------------------------------------------------
  UseDecl = use stringLiteral

  // Wraps an included file as an object/text box.
  // The file only needs object properties and when blocks; its name is the file name.
  UseObjectDecl
    = useobject stringLiteral -- object
    | usetext stringLiteral   -- text

  // A file included via `use` contains only the fragment matching its context.
  // The compiler picks the start rule based on context (Program / SceneFragment / ObjectFragment).
  SceneFragment  = SceneMember*
  ObjectFragment = ObjectMember*

  // --- 3.2 project (project metadata) ----------------------------------------
  ProjectDecl = project blockOpen ProjectField* end_

  ProjectField
    = title stringLiteral        -- title
    | description stringLiteral  -- description
    | fps numberLiteral          -- fps

  // --- 3.4 scene ---------------------------------------------------------------
  SceneDecl = scene stringLiteral blockOpen SceneMember* end_

  SceneMember
    = ObjectDecl
    | TextDecl
    | UseObjectDecl
    | UseDecl
    | SceneNameDecl

  // Mirrors an object's `name "..."`: separates the scene identifier
  // (referenced by `jump` in scripts) from the display name in the compiled project.
  SceneNameDecl = name stringLiteral

  // --- 3.5 object / 3.6 text ---------------------------------------------------
  ObjectDecl = object stringLiteral blockOpen ObjectMember* end_
  TextDecl   = text   stringLiteral blockOpen ObjectMember* end_

  ObjectMember
    = PropertyDecl
    | VarDecl
    | ListDecl
    | FunctionDecl
    | EventHandler
    | UseDecl

  // Object property. Forms with a prefix keyword (e.g. `default costume`) must come first.
  // `size W H` after a costume declares its original size when the image file can't be found.
  // `force id "..."` (see SPEC-ADDENDUM.md) pins this costume/sound's Entry id to the given
  // string instead of deriving it from a seed -- used when decompiling to restore legacy hardcoded ids.
  PropertyDecl
    = default costume identifier stringLiteral size numberLiteral numberLiteral ForceId? -- defaultCostumeSized
    | default costume identifier stringLiteral ForceId?                                  -- defaultCostume
    | costume identifier stringLiteral size numberLiteral numberLiteral ForceId?         -- costumeSized
    | costume identifier stringLiteral ForceId?                                          -- costume
    | sound identifier stringLiteral for numberLiteral ForceId?                          -- soundLength
    | sound identifier stringLiteral ForceId?                                            -- sound
    | name stringLiteral                                                                 -- name
    | visible booleanLiteral                                                             -- visible
    | lock booleanLiteral                                                                -- lock
    | rotation rotateMethod                                                              -- rotation
    | propertyName "=" ~"=" Expr                                                         -- assign

  ForceId = force id stringLiteral

  // Property names that accept an `=` initial value.
  // Longer names must come first (PEG alternation takes the first match, so
  // if "font" precedes "font_color", "font_color" can never match).
  propertyName
    = ("scale_x" | "scale_y" | "size"
      | "text_content" | "text_bold" | "text_italic"
      | "text_underline" | "text_strikethrough" | "text_align"
      | "font_color" | "font_size" | "font" | "bg_color" | "line_break"
      | "draw_color" | "draw_width" | "draw_alpha" | "fill_color"
      | "angle" | "way" | "x" | "y") ~identifierPart

  // 3.5 rotation method (Entry rotateMethod)
  rotateMethod = free | vertical | none

  // --- 14. Functions -----------------------------------------------------------
  // A trailing `?` on a parameter name marks it as a post-compile boolean argument
  // -- becomes Entry's function_field_boolean (SPEC-ADDENDUM.md 4.6).
  FunctionDecl
    = function identifier "(" ListOf<FunctionParam, ","> ")" blockOpen Block end_

  FunctionParam = identifier "?"?

  // --- 13. Data (variable / list declarations) ---------------------------------
  VarDecl  = var  identifier "=" ~"=" Expr
  ListDecl = list identifier "=" ~"=" ListLiteral

  // ==========================================================================
  //  2. Events (chapter 6)
  // ==========================================================================

  EventHandler
    = when scene start blockOpen Block end_           -- sceneStart
    | when start blockOpen Block end_                 -- start
    | when key stringLiteral up blockOpen Block end_  -- keyUp
    | when key stringLiteral blockOpen Block end_     -- key
    | when stage click up blockOpen Block end_        -- stageClickUp
    | when stage click blockOpen Block end_           -- stageClick
    | when click up blockOpen Block end_              -- clickUp
    | when click blockOpen Block end_                 -- click
    | when signal stringLiteral blockOpen Block end_  -- signal
    | when cloned blockOpen Block end_                -- cloned

  // ==========================================================================
  //  3. Statements
  // ==========================================================================

  Block = Statement*

  // 4.1 block opener: any of `then`, `do`, `:`. Always closed with `end`.
  blockOpen = ":" | then | do

  // Keyword-led statements are all tried first; identifier-led assign/call
  // statements are placed last.
  Statement
    = IfStatement
    | RepeatStatement
    | WhileStatement
    | UntilStatement
    | ForeverStatement
    | WaitStatement
    | ReturnStatement
    | FlowStatement
    | StopStatement
    | StartStatement
    | ResetStatement
    | ClearStatement
    | SignalStatement
    | CloneStatement
    | DeleteStatement
    | JumpStatement
    | MoveStatement
    | RotateStatement
    | LooksStatement
    | TextStatement
    | PenStatement
    | SoundStatement
    | ReadStatement
    | TtsStatement
    | DataStatement
    | VarDecl
    | ListDecl
    | AssignStatement
    | CallStatement

  // --- 5.1 conditionals ---------------------------------------------------------
  IfStatement
    = if Expr blockOpen Block else blockOpen Block end_  -- ifElse
    | if Expr blockOpen Block end_                       -- if

  // --- 5.2 loops ------------------------------------------------------------
  RepeatStatement  = repeat Expr blockOpen Block end_
  WhileStatement   = while Expr blockOpen Block end_
  UntilStatement   = until Expr blockOpen Block end_
  ForeverStatement = forever blockOpen Block end_

  // --- 5.3 control flow ---------------------------------------------------------
  WaitStatement = wait Expr

  FlowStatement
    = break   -- break
    | skip    -- skip
    | restart -- restart

  ReturnStatement = return Expr

  // `stop`'s meaning depends entirely on the keyword that follows.
  // Forms with an argument are tried first; bare `stop` comes last.
  StopStatement
    = stop sound this  -- soundThis
    | stop sound all   -- soundAll
    | stop draw        -- draw
    | stop fill        -- fill
    | stop bgm         -- bgm
    | stop timer       -- timer
    | stop other       -- other
    | stop me          -- me
    | stop them        -- them
    | stop all         -- all
    | stop             -- script

  StartStatement
    = start draw   -- draw
    | start fill   -- fill
    | start timer  -- timer

  ResetStatement
    = reset size   -- size
    | reset timer  -- timer

  ClearStatement
    = clear effects -- effects
    | clear bubble  -- bubble
    | clear draw    -- draw
    | clear text    -- text

  // --- 7.1 signal messaging ---------------------------------------------------------
  SignalStatement
    = send Expr -- send
    | call Expr -- call

  // --- 7.2 clone control -------------------------------------------------------
  // A bare `clone` followed by an identifier on the next line would otherwise
  // swallow that identifier as its argument, so the argument is restricted
  // to the same line (#sameLine).
  CloneStatement
    = clone #sameLine Expr -- target
    | clone                -- self

  DeleteStatement
    = del clones -- clones
    | del clone  -- clone
    | kill       -- kill

  // --- 7.3 scene transitions ---------------------------------------------------------
  JumpStatement
    = jump next -- next
    | jump back -- back
    | jump Expr -- named

  // --- 8.1 position and movement -------------------------------------------------------
  // Commands listing two space-separated arguments restrict each argument to
  // unary level (PosExpr); otherwise `move 50 -30` would parse as `move (50 - 30)`.
  // Binary operations require explicit parens, e.g. `move (a + b) 10`.
  MoveStatement
    = forward Expr at Expr                   -- forwardAt
    | forward Expr                           -- forward
    | bounce                                 -- bounce
    | move PosExpr #sameLine PosExpr in Expr -- moveIn
    | move PosExpr #sameLine PosExpr         -- move
    | go PosExpr #sameLine PosExpr in Expr   -- goPointIn
    | go PosExpr #sameLine PosExpr           -- goPoint
    | go Expr in Expr                        -- goTargetIn
    | go Expr                                -- goTarget

  // --- 8.2 angle and direction -------------------------------------------------------
  RotateStatement
    = turn Expr in Expr  -- turnIn
    | turn Expr          -- turn
    | steer Expr in Expr -- steerIn
    | steer Expr         -- steer
    | look Expr          -- look

  // --- 8.3 costume and size / 8.4 speech and thought -------------------------------
  // `show` / `hide` also have argument-less forms, so the argument is
  // restricted to the same line via `#sameLine` (same technique as ES5's
  // postfix `++`). Without this, the following would parse as `hide say`:
  //     hide
  //     say "hidden"
  LooksStatement
    = show #sameLine identifier -- showTarget
    | show                      -- show
    | hide #sameLine identifier -- hideTarget
    | hide                      -- hide
    | next costume              -- nextCostume
    | prev costume              -- prevCostume
    | say Expr for Expr         -- sayFor
    | say Expr                  -- say
    | think Expr for Expr       -- thinkFor
    | think Expr                -- think
    | flip x                    -- flipX
    | flip y                    -- flipY
    | order front               -- orderFront
    | order back                -- orderBack

  // --- 8.5 text box control -------------------------------------------------------
  TextStatement
    = write Expr   -- write
    | append Expr  -- append
    | prepend Expr -- prepend

  // --- 9. Pen -----------------------------------------------------------------
  PenStatement = stamp

  // --- 10. Sound --------------------------------------------------------------
  // Longer forms (with trailing `and wait`) must be tried first.
  SoundStatement
    = play sound Expr for Expr and wait          -- soundForWait
    | play sound Expr from Expr to Expr and wait -- soundRangeWait
    | play sound Expr and wait                   -- soundWait
    | play sound Expr for Expr                   -- soundFor
    | play sound Expr from Expr to Expr          -- soundRange
    | play sound Expr                            -- sound
    | play bgm Expr                              -- bgm

  // --- 11. TTS speech (addendum) --------------------------------------------
  // Longer form (`and wait`) is tried first, same reasoning as play sound.
  ReadStatement
    = read Expr and wait -- readWait
    | read Expr           -- read

  TtsStatement = tts voice stringLiteral speed stringLiteral pitch stringLiteral

  // --- 13.2 list operations / 13.3 ask & answer ------------------------------
  DataStatement
    = in identifier add Expr            -- listAdd
    | in identifier insert Expr at Expr -- listInsert
    | remove identifier "[" Expr "]"    -- listRemove
    | ask Expr                          -- ask

  // --- assignment / function call ------------------------------------------------------
  AssignStatement = LValue assignOperator Expr

  LValue
    = identifier "[" Expr "]" -- index
    | identifier              -- name

  CallStatement = CallExpr

  // ==========================================================================
  //  4. Expressions (4.2 operators, 12 built-in functions)
  //
  //  Precedence (low -> high)
  //    or < and < not < comparison < +,- < *,/,%,// < ** < unary - < primary
  // ==========================================================================

  Expr = OrExpr

  OrExpr
    = OrExpr or AndExpr -- or
    | AndExpr

  AndExpr
    = AndExpr and NotExpr -- and
    | NotExpr

  NotExpr
    = not NotExpr -- not
    | CompareExpr

  // `<=` must precede `<`, `>=` must precede `>`.
  CompareExpr
    = CompareExpr "==" AddExpr -- eq
    | CompareExpr "!=" AddExpr -- ne
    | CompareExpr "<=" AddExpr -- le
    | CompareExpr ">=" AddExpr -- ge
    | CompareExpr "<" AddExpr  -- lt
    | CompareExpr ">" AddExpr  -- gt
    | AddExpr

  AddExpr
    = AddExpr "+" ~"=" MulExpr -- add
    | AddExpr "-" ~"=" MulExpr -- sub
    | MulExpr

  // `//` (int div) is checked before `/` (div); `**` (pow) before `*` (mul).
  MulExpr
    = MulExpr "//" PowExpr      -- intDiv
    | MulExpr "*" ~"*" PowExpr  -- mul
    | MulExpr "/" ~"=" PowExpr  -- div
    | MulExpr "%" ~"=" PowExpr  -- mod
    | PowExpr

  // Exponentiation is right-associative: 2 ** 3 ** 2 == 2 ** (3 ** 2)
  PowExpr
    = UnaryExpr "**" ~"=" PowExpr -- pow
    | UnaryExpr

  UnaryExpr
    = "-" UnaryExpr -- neg
    | PrimaryExpr

  // Expression form without binary operators, used for space-separated argument lists.
  PosExpr = UnaryExpr

  PrimaryExpr
    = "(" Expr ")"           -- paren
    | CallExpr
    | IndexExpr
    | numberLiteral
    | stringLiteral
    | booleanLiteral
    | colorLiteral
    | transparent            -- transparent
    | identifier

  // Function calls are only allowed directly after an identifier (no first-class functions).
  // This avoids misreading a `(` on the next line as a call on the previous expression.
  CallExpr  = identifier "(" ListOf<Expr, ","> ")"
  IndexExpr = identifier "[" Expr "]"

  ListLiteral = "[" ListOf<Expr, ","> "]"

  // ==========================================================================
  //  5. Lexical rules (terminals)
  // ==========================================================================

  // --- whitespace and comments -----------------------------------------------------------
  // Tess comments start with `#`. Since color literals also start with `#ff0000`,
  // a negative lookahead distinguishes them: it's a comment only when `#` is not
  // followed by a color body.
  space += comment

  comment = "#" ~colorBody (~lineTerminator any)*

  lineTerminator = "\n" | "\r" | "\u2028" | "\u2029"

  // Skips whitespace only, excluding line terminators.
  spacesNoNL = (~lineTerminator space)*

  // Zero-width guard checking whether the next token is still on the same line.
  // Must be used lexically, as in `#sameLine` -- using it directly would let a
  // syntactic rule's automatic whitespace skip consume the newline first,
  // making the check meaningless.
  sameLine = ~(spacesNoNL lineTerminator)

  // --- literals ---------------------------------------------------------------
  numberLiteral (a number)
    = digit+ "." digit+ -- decimal
    | digit+            -- integer

  stringLiteral (a string) = "\"" stringChar* "\""

  stringChar
    = "\\u" hexDigit hexDigit hexDigit hexDigit -- unicodeEscape
    | "\\" any                                  -- escape
    | ~("\"" | "\\" | lineTerminator) any       -- plain

  booleanLiteral = true | false

  colorLiteral (a color) = "#" colorBody
  colorBody = hexDigit hexDigit hexDigit hexDigit hexDigit hexDigit ~identifierPart

  // --- identifiers ---------------------------------------------------------------
  identifier (an identifier) = ~keyword identifierName
  identifierName  = identifierStart identifierPart*
  identifierStart = letter | "_"
  identifierPart  = alnum | "_"

  // Minimal reserved-word set: only blocks names that could otherwise be
  // swallowed by an expression (operators, block delimiters, `and wait`).
  // Property-style names like `name`, `size`, `costume` remain usable as identifiers.
  keyword = and | or | not | true | false | end_ | then | do | in | wait

  // --- keywords ---------------------------------------------------------------
  // Every keyword is closed with `~identifierPart` so `forward` doesn't match
  // as `for`, and `to_hex` doesn't match as `to`.
  add         = "add"         ~identifierPart
  all         = "all"         ~identifierPart
  and         = "and"         ~identifierPart
  append      = "append"      ~identifierPart
  ask         = "ask"         ~identifierPart
  at          = "at"          ~identifierPart
  back        = "back"        ~identifierPart
  bgm         = "bgm"         ~identifierPart
  bounce      = "bounce"      ~identifierPart
  break       = "break"       ~identifierPart
  bubble      = "bubble"      ~identifierPart
  call        = "call"        ~identifierPart
  clear       = "clear"       ~identifierPart
  click       = "click"       ~identifierPart
  clone       = "clone"       ~identifierPart
  cloned      = "cloned"      ~identifierPart
  clones      = "clones"      ~identifierPart
  costume     = "costume"     ~identifierPart
  default     = "default"     ~identifierPart
  del         = "del"         ~identifierPart
  description = "description" ~identifierPart
  do          = "do"          ~identifierPart
  draw        = "draw"        ~identifierPart
  effects     = "effects"     ~identifierPart
  else        = "else"        ~identifierPart
  end_        = "end"         ~identifierPart
  false       = "false"       ~identifierPart
  fill        = "fill"        ~identifierPart
  flip        = "flip"        ~identifierPart
  for         = "for"         ~identifierPart
  force       = "force"       ~identifierPart
  forever     = "forever"     ~identifierPart
  forward     = "forward"     ~identifierPart
  fps         = "fps"         ~identifierPart
  free        = "free"        ~identifierPart
  from        = "from"        ~identifierPart
  front       = "front"       ~identifierPart
  function    = "function"    ~identifierPart
  go          = "go"          ~identifierPart
  hide        = "hide"        ~identifierPart
  id          = "id"          ~identifierPart
  if          = "if"          ~identifierPart
  in          = "in"          ~identifierPart
  insert      = "insert"      ~identifierPart
  jump        = "jump"        ~identifierPart
  key         = "key"         ~identifierPart
  kill        = "kill"        ~identifierPart
  list        = "list"        ~identifierPart
  lock        = "lock"        ~identifierPart
  look        = "look"        ~identifierPart
  me          = "me"          ~identifierPart
  move        = "move"        ~identifierPart
  name        = "name"        ~identifierPart
  next        = "next"        ~identifierPart
  none        = "none"        ~identifierPart
  not         = "not"         ~identifierPart
  object      = "object"      ~identifierPart
  or          = "or"          ~identifierPart
  order       = "order"       ~identifierPart
  other       = "other"       ~identifierPart
  pitch       = "pitch"       ~identifierPart
  play        = "play"        ~identifierPart
  prepend     = "prepend"     ~identifierPart
  prev        = "prev"        ~identifierPart
  project     = "project"     ~identifierPart
  read        = "read"        ~identifierPart
  remove      = "remove"      ~identifierPart
  repeat      = "repeat"      ~identifierPart
  reset       = "reset"       ~identifierPart
  restart     = "restart"     ~identifierPart
  return      = "return"      ~identifierPart
  rotation    = "rotation"    ~identifierPart
  say         = "say"         ~identifierPart
  scene       = "scene"       ~identifierPart
  send        = "send"        ~identifierPart
  signal      = "signal"      ~identifierPart
  show        = "show"        ~identifierPart
  size        = "size"        ~identifierPart
  skip        = "skip"        ~identifierPart
  sound       = "sound"       ~identifierPart
  speed       = "speed"       ~identifierPart
  stage       = "stage"       ~identifierPart
  stamp       = "stamp"       ~identifierPart
  start       = "start"       ~identifierPart
  steer       = "steer"       ~identifierPart
  stop        = "stop"        ~identifierPart
  text        = "text"        ~identifierPart
  them        = "them"        ~identifierPart
  then        = "then"        ~identifierPart
  think       = "think"       ~identifierPart
  this        = "this"        ~identifierPart
  timer       = "timer"       ~identifierPart
  title       = "title"       ~identifierPart
  to          = "to"          ~identifierPart
  transparent = "transparent" ~identifierPart
  true        = "true"        ~identifierPart
  tts         = "tts"         ~identifierPart
  turn        = "turn"        ~identifierPart
  until       = "until"       ~identifierPart
  up          = "up"          ~identifierPart
  use         = "use"         ~identifierPart
  useobject   = "useobject"   ~identifierPart
  usetext     = "usetext"     ~identifierPart
  var         = "var"         ~identifierPart
  vertical    = "vertical"    ~identifierPart
  visible     = "visible"     ~identifierPart
  voice       = "voice"       ~identifierPart
  wait        = "wait"        ~identifierPart
  when        = "when"        ~identifierPart
  while       = "while"       ~identifierPart
  write       = "write"       ~identifierPart
  x           = "x"           ~identifierPart
  y           = "y"           ~identifierPart

  // --- assignment operators -----------------------------------------------------------
  // `**=` must precede `*=`; plain `=` is checked last to distinguish from `==`.
  assignOperator = "+=" | "-=" | "**=" | "*=" | "/=" | "%=" | "=" ~"="
}
