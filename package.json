{
  "name": "tess-monorepo",
  "version": "1.0.0",
  "description": "Tess 언어(엔트리 블록 코드로 변환되는 텍스트 언어) 모노레포",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/player/tsconfig.browser.json && tsc --noEmit -p packages/tessvm/tsconfig.browser.json",
    "tess": "node packages/cli/index.ts",
    "build:grammar": "node editors/vscode/build-grammar.ts",
    "tessvm": "node packages/tessvm/src/node/cli.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@entrylabs/entry": "^4.0.22",
    "@tess/compiler": "workspace:*",
    "@tess/core": "workspace:*",
    "@tess/decompiler": "workspace:*",
    "@tess/parser": "workspace:*",
    "@tess/player": "workspace:*",
    "@tess/vm": "workspace:*",
    "@types/babel__code-frame": "^7.27.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "jsdom": "^30.0.1",
    "tess": "workspace:*",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
