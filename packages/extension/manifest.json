{
  "manifest_version": 3,
  "name": "tessvm for Entry",
  "version": "0.1.5",
  "description": "엔트리 작품 실행 화면을 tessvm 실행기로 바꿉니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "tessvm",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://playentry.org/*"],
      "exclude_matches": [
        "https://playentry.org/ws*",
        "https://playentry.org/iframe/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page/*", "vendor/*", "player.css"],
      "matches": ["https://playentry.org/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tessvm@tess.playentry",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
