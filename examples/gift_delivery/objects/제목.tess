name "제목 글상자"
text_content = "선물 배달 대작전"
font = "DungGeunMo"
font_size = 32
font_color = #ffffff
bg_color = transparent
text_bold = true
text_align = center
x = 0
y = 80

when scene start do
  # 글상자는 밝기·색깔 효과를 쓸 수 없어서 글씨색과 크기로 눈에 띄게 한다
  forever:
    font_color = #ffe066
    size = 105
    wait 0.4
    font_color = #ffffff
    size = 100
    wait 0.4
  end
end
