name "선물 상자"
default costume 상자 "gift.png" size 80 80
sound 획득 "get.mp3" for 0.4
x = 0
y = 200
visible false

when signal "게임 시작" do
  hide
  repeat 12:
    clone
    wait 0.8
  end
end

when cloned do
  show
  go random(-220, 220) 200
  until y < -140:
    y -= 5
    if touching("플레이어"):
      play sound "획득"
      점수_더하기(보너스(10))
      남은_선물 -= 1
      kill
    end
    wait 0.02
  end
  kill
end

when signal "게임 오버" do
  del clones
  hide
end
