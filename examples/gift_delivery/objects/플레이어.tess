name "치로(썰매)"
default costume 정지 "sled_idle.png" size 140 120
costume 달리기 "sled_run.png" size 140 120
sound 부딪힘 "crash.mp3" for 0.6
x = -180
y = -120
scale_x = 100
scale_y = 100
rotation vertical

when signal "게임 시작" do
  go -180 -120
  show
  # 원래 비율로 되돌려 놓고 시작한다
  scale_x = 100
  scale_y = 100
  forever:
    if key_down("right"):
      x += 6
      next costume
    end
    if key_down("left"):
      x -= 6
      next costume
    end
    if key_down("space"):
      repeat 8:
        y += 9
        wait 0.02
      end
      repeat 8:
        y -= 9
        wait 0.02
      end
    end
    if x > 220:
      x = 220
    end
    if x < -220:
      x = -220
    end
    wait 0.02
  end
end

when signal "게임 시작" do
  # 30초가 지나면 게임을 끝낸다
  until 게임중 == 0:
    if timer > 30:
      send "게임 오버"
    end
    wait 0.5
  end
end

when key "s" do
  # 부딪히면 납작해졌다가 돌아온다
  play sound "부딪힘"
  effect_brightness = 80
  scale_y = 60
  wait 0.2
  scale_y = 100
  clear effects
end
