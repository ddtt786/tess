object "시작 버튼":
  name "시작 버튼"
  costume 기본 "btn_start.png" size 240 90
  costume 눌림 "btn_start_pressed.png" size 240 90
  sound 딸깍 "click.mp3"
  x = 0
  y = -90

  when click do
    costume = "눌림"
    play sound "딸깍" and wait
    costume = "기본"
    jump "아지트"
  end

  when scene start do
    size = 100
    forever:
      size += 4
      wait 0.05
      size -= 4
      wait 0.05
    end
  end
end
